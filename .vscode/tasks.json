{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Offline strategy demo",
      "type": "process",
      "command": "python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "linux": {"command": "/opt/venv/bin/python"},
      "args": ["-m", "optiver_bot.demo"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "process",
      "command": "python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "linux": {"command": "/opt/venv/bin/python"},
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Check Optibook cloud environment (no connection)",
      "type": "process",
      "command": "python",
      "windows": {"command": "${workspaceFolder}/.venv/Scripts/python.exe"},
      "linux": {"command": "/opt/venv/bin/python"},
      "args": ["scripts/check_cloud.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
